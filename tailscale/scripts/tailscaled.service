#!/system/bin/sh
# tailscaled service control and Android routing.
#
#   tailscaled.service start|stop|restart|status
#   tailscaled.service routes      show the installed routing state
#   tailscaled.service diag        full diagnostic dump
#   tailscaled.service log {runs|service|tailscaled|diag}
#
# Why this script exists at all: a GOOS=android tailscaled has no osrouter
# (wgengine/router/osrouter/router_linux.go is `//go:build !android`), so it
# installs no ip rules and no routes and does not use SO_MARK. The official
# Android app supplies routing through Java VpnService; a standalone daemon has
# to supply it itself. We install the minimum: only the tailnet prefixes, only
# by destination, in a private table, so a proxy is never disturbed.
DIR=${0%/*}
. "${DIR}/../settings.ini"
scripts_name=$(basename "$0")

# settings.ini is only written on first install, so an upgrade keeps the previous
# copy. Fill in anything it may not define yet instead of failing.
: "${tailscale_dir:=/data/adb/tailscale}"
: "${tailscale_bin:=${tailscale_dir}/bin/tailscale}"
: "${tailscaled_bin:=${tailscale_dir}/bin/tailscaled}"
: "${tailscaled_bin_pristine:=${tailscaled_bin}.orig}"
: "${tailscaled_bin_sum:=${tailscaled_bin}.sha256}"
: "${tailscaled_run_dir:=${tailscale_dir}/run}"
: "${tailscale_routes_file:=${tailscale_dir}/routes}"
: "${tailscale_routes_auto_file:=${tailscale_dir}/routes.auto}"
: "${tailscaled_log:=${tailscaled_run_dir}/tailscaled.log}"
: "${tailscaled_pid:=${tailscaled_run_dir}/tailscaled.pid}"
: "${tailscaled_runs_log:=${tailscaled_run_dir}/runs.log}"
: "${tailscaled_service_log:=${tailscaled_run_dir}/service.log}"
: "${tailscaled_diag_log:=${tailscaled_run_dir}/diag.log}"
: "${module_prop:=/data/adb/modules/tailscaled/module.prop}"
: "${sync_routes_auto:=1}"
: "${sync_every_ticks:=4}"
: "${tun_iface:=tailscale0}"
: "${tun_table:=1099}"
: "${tun_rule_pref:=12000}"

# ---------------------------------------------------------------- helpers ---
daemon_pid() {
  if [ -f "${tailscaled_pid}" ]; then
    _p=$(cat "${tailscaled_pid}" 2>/dev/null)
    if [ -n "${_p}" ] && kill -0 "${_p}" 2>/dev/null; then echo "${_p}"; return 0; fi
  fi
  pgrep -f "statedir=${tailscaled_run_dir}" 2>/dev/null | head -n1
}

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" 2>/dev/null | awk '{print $1}'
  elif command -v busybox >/dev/null 2>&1; then
    busybox sha256sum "$1" 2>/dev/null | awk '{print $1}'
  fi
}

set_module_status() {
  [ -w "${module_prop}" ] || return 0
  sed -i "s#^description=.*#description=[ $1 ] Tailscale for Android (self-contained GOOS=android build)#" "${module_prop}" 2>/dev/null
}

# ------------------------------------------------- binary integrity guard ---
# `tailscale update` replaces our binary with the OFFICIAL upstream release,
# which is built for GOOS=linux. That build activates osrouter: it tags its own
# sockets with fwmark 0x80000 and routes them via `lookup main` (empty on
# Android), and it adds ip rules plus ts-* iptables chains. The result is exactly
# the "link blocked / network is unreachable" failure. Restore our copy instead.
ensure_binary() {
  if [ ! -f "${tailscaled_bin}" ]; then
    log Error "binary missing: ${tailscaled_bin}"
    return 1
  fi
  if [ ! -f "${tailscaled_bin_pristine}" ]; then
    cp -f "${tailscaled_bin}" "${tailscaled_bin_pristine}" 2>/dev/null
    hash_file "${tailscaled_bin_pristine}" > "${tailscaled_bin_sum}" 2>/dev/null
    chmod 755 "${tailscaled_bin_pristine}" 2>/dev/null
    diag "binary-guard: stored pristine copy"
    return 0
  fi
  _want=$(cat "${tailscaled_bin_sum}" 2>/dev/null)
  [ -n "${_want}" ] || return 0
  _have=$(hash_file "${tailscaled_bin}")
  if [ -n "${_have}" ] && [ "${_have}" != "${_want}" ]; then
    log Warning "binary was replaced (tailscale update?) - restoring the module build"
    diag "binary-guard: ${_have} != ${_want} -> restoring pristine copy"
    _dp=$(daemon_pid)
    [ -n "${_dp}" ] && kill -15 "${_dp}" 2>/dev/null
    sleep 1
    cp -f "${tailscaled_bin_pristine}" "${tailscaled_bin}"
    chmod 755 "${tailscaled_bin}"
    diag "binary-guard: restored (hash $(hash_file "${tailscaled_bin}"))"
  fi
  return 0
}

# --------------------------------------------------------------- routing ---
# Prefixes routed into the TUN device. The union of two files:
#   routes       hand-written by you, never rewritten by the module
#   routes.auto  discovered from the tailnet (see routes_sync)
# '#' starts a comment in either.
route_prefixes() {
  _pf=""
  for _f in "${tailscale_routes_file}" "${tailscale_routes_auto_file}"; do
    if [ -f "${_f}" ]; then
      _pf="${_pf}
$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "${_f}" 2>/dev/null | grep -E '^[0-9a-fA-F:.]+/[0-9]+$')"
    fi
  done
  _pf=$(printf '%s\n' "${_pf}" | grep -E '^[0-9a-fA-F:.]+/[0-9]+$' | sort -u)
  if [ -n "${_pf}" ]; then
    printf '%s\n' "${_pf}"
  else
    echo "100.64.0.0/10"
  fi
}

wait_tun() {
  _i=0
  while [ "${_i}" -lt 30 ]; do
    if ip link show "${tun_iface}" >/dev/null 2>&1; then
      diag "tun: interface ${tun_iface} is up after ${_i}s"
      return 0
    fi
    sleep 1
    _i=$((_i + 1))
  done
  diag "tun: interface ${tun_iface} did NOT appear within ${_i}s"
  return 1
}

routes_ok() {
  ip link show "${tun_iface}" >/dev/null 2>&1 || return 1
  _prefixes=$(route_prefixes)
  [ -n "${_prefixes}" ] || return 1
  for _pfx in ${_prefixes}; do
    ip route show table "${tun_table}" 2>/dev/null | grep -q "^${_pfx} " || return 1
    ip rule show 2>/dev/null | grep -q "to ${_pfx} lookup ${tun_table}" || return 1
  done
  return 0
}

# Surfing/Clash TPROXY inserts DIVERT at mangle PREROUTING rule 1, matching
# "-p tcp -m socket" with no interface condition. It marks (0x1000000) and
# ACCEPTs the SYN-ACK of every TCP connection egressing via the TUN device, so
# the packet is routed to the proxy's TPROXY port instead of the local socket and
# the handshake never completes. ICMP never matches, hence the deceptive
# "ping works but the browser hangs". The exemption must live in PREROUTING
# itself, ahead of DIVERT: a rule inside BOX_EXTERNAL is useless because DIVERT
# is evaluated first.
exempt_tunnel() {
  _exempt_one mangle PREROUTING -i
  _exempt_one mangle OUTPUT     -o
  _exempt_one nat    OUTPUT     -o
  return 0
}

# Move "RETURN for tunnel traffic" to rule 1 of the given chain, if it is not
# already the first rule. Cheap to call repeatedly, so the watchdog can re-assert
# it every tick.
_exempt_one() {
  _tbl=$1
  _chn=$2
  _dir=$3
  iptables -t "$_tbl" -L "$_chn" -n >/dev/null 2>&1 || return 0
  if iptables -t "$_tbl" -L "$_chn" -n -v --line-numbers 2>/dev/null \
       | awk -v i="${tun_iface}" '$1 == 1 && $0 ~ i { f = 1 } END { exit !f }'; then
    return 0
  fi
  iptables -t "$_tbl" -D "$_chn" "$_dir" "${tun_iface}" -j RETURN 2>/dev/null
  if iptables -t "$_tbl" -I "$_chn" 1 "$_dir" "${tun_iface}" -j RETURN 2>/dev/null; then
    diag "proxy: ${_tbl}/${_chn} rule 1 -> RETURN ${_dir} ${tun_iface}"
  fi
  return 0
}

add_routes() {
  wait_tun || return 1
  for _pfx in $(route_prefixes); do
    if ip route replace "${_pfx}" dev "${tun_iface}" table "${tun_table}" 2>/dev/null; then
      diag "routes: table ${tun_table}: ${_pfx} dev ${tun_iface}"
    else
      diag "routes: WARN could not add ${_pfx} to table ${tun_table}"
    fi
    ip route replace "${_pfx}" dev "${tun_iface}" metric 1 2>/dev/null
    if ip rule show 2>/dev/null | grep -q "to ${_pfx} lookup ${tun_table}"; then
      diag "routes: rule to ${_pfx} already present"
    elif ip rule add to "${_pfx}" lookup "${tun_table}" pref "${tun_rule_pref}" 2>/dev/null; then
      diag "routes: rule to ${_pfx} lookup ${tun_table} pref ${tun_rule_pref}"
    else
      diag "routes: WARN could not add rule for ${_pfx}"
    fi
  done
  exempt_tunnel
  return 0
}

del_routes() {
  for _pfx in $(route_prefixes); do
    ip rule del to "${_pfx}" lookup "${tun_table}" pref "${tun_rule_pref}" 2>/dev/null
    ip route del "${_pfx}" dev "${tun_iface}" metric 1 2>/dev/null
  done
  ip route flush table "${tun_table}" 2>/dev/null
  diag "routes: removed"
}

# Android's netd rewrites the routing tables on every network transition, and a
# proxy may reload its firewall at any time, so re-assert periodically.
route_watchdog() {
  _tick=0
  while :; do
    sleep 15
    _tick=$((_tick + 1))
    [ -n "$(daemon_pid)" ] || { diag "watchdog: daemon gone, exiting"; exit 0; }
    if ! routes_ok; then
      diag "watchdog: routes missing or stale -> re-asserting"
      add_routes
    else
      exempt_tunnel
    fi
    # Periodically pick up subnet routes that appeared or disappeared in the
    # tailnet. One status query per interval, so this stays cheap.
    if [ "${sync_routes_auto}" = "1" ]; then
      _every=${sync_every_ticks:-4}
      case "${_every}" in ''|*[!0-9]*|0) _every=4 ;; esac
      if [ "$((_tick % _every))" -eq 0 ]; then
        routes_sync
      fi
    fi
  done
}

start_watchdog() {
  _wp=$(cat "${tailscaled_run_dir}/watchdog.pid" 2>/dev/null)
  if [ -n "${_wp}" ] && kill -0 "${_wp}" 2>/dev/null; then return 0; fi
  nohup "${tailscaled_service}" __watchdog >> "${tailscaled_diag_log}" 2>&1 < /dev/null &
  echo $! > "${tailscaled_run_dir}/watchdog.pid"
  diag "watchdog: started (pid $!)"
}

stop_watchdog() {
  _wp=$(cat "${tailscaled_run_dir}/watchdog.pid" 2>/dev/null)
  [ -n "${_wp}" ] && kill "${_wp}" 2>/dev/null
  rm -f "${tailscaled_run_dir}/watchdog.pid"
  diag "watchdog: stopped"
}

# ---------------------------------------------------------------- service ---
start_tailscaled() {
  _pid=$(daemon_pid)
  if [ -n "${_pid}" ]; then
    log Info "tailscaled already running (PID ${_pid})."
    diag "start: already running (PID ${_pid})"
    add_routes
    start_watchdog
    [ "${sync_routes_auto}" = "1" ] && routes_sync
    return 0
  fi
  ensure_binary || return 1
  setup_home
  mkdir -p "${tailscaled_run_dir}" "${tailscale_dir}/tmp" 2>/dev/null
  export TMPDIR="${tailscale_dir}/tmp"
  rm -f "${tailscaled_run_dir}/tailscaled.sock" 2>/dev/null
  nohup "${tailscaled_bin}" ${tailscaled_bin_param} >> "${tailscaled_log}" 2>&1 &
  _pid=$!
  echo "${_pid}" > "${tailscaled_pid}"
  log Info "tailscaled started (PID ${_pid})."
  set_module_status "✔ running | $current_time"
  sleep 3
  if [ -z "$(daemon_pid)" ]; then
    log Error "tailscaled exited immediately - see: ${scripts_name} log tailscaled"
    diag "start: daemon not alive 3s after launch"
    return 1
  fi
  add_routes
  start_watchdog
  # Best effort: discourage Tailscale's own updater from replacing our binary.
  "${tailscale_bin}" ${tailscale_bin_param} set --auto-update=false >/dev/null 2>&1
  # Pick up the subnet routes the tailnet offers right away (exit 2 = the user
  # still has --accept-routes off; nothing to do until they enable it).
  [ "${sync_routes_auto}" = "1" ] && routes_sync
  return 0
}

stop_tailscaled() {
  stop_watchdog
  _pid=$(daemon_pid)
  if [ -n "${_pid}" ]; then
    kill -15 "${_pid}" 2>/dev/null
    sleep 1
    [ -n "$(daemon_pid)" ] && kill -9 "${_pid}" 2>/dev/null
    log Info "tailscaled stopped."
  else
    log Info "tailscaled already stopped."
  fi
  rm -f "${tailscaled_pid}"
  del_routes
  set_module_status "✘ stopped | $current_time"
  return 0
}

show_status() {
  _pid=$(daemon_pid)
  if [ -n "${_pid}" ]; then
    log Info "tailscaled is running (PID ${_pid})."
  else
    log Info "tailscaled is stopped."
  fi
}

show_routes() {
  echo "manual (routes):        $(grep -E '^[0-9a-fA-F:.]+/[0-9]+$' "${tailscale_routes_file}" 2>/dev/null | tr '\n' ' ')"
  echo "discovered (routes.auto): $(grep -E '^[0-9a-fA-F:.]+/[0-9]+$' "${tailscale_routes_auto_file}" 2>/dev/null | tr '\n' ' ')"
  echo "in use:                 $(route_prefixes | tr '\n' ' ')"
  echo "tun device:             ${tun_iface} $([ -d /sys/class/net/${tun_iface} ] && echo '(up)' || echo '(down)')"
  echo "table ${tun_table}:"
  ip route show table "${tun_table}" 2>/dev/null | sed 's/^/  /'
  echo "ip rules:"
  ip rule show 2>/dev/null | grep "to .* lookup ${tun_table}" | sed 's/^/  /'
}

show_exemptions() {
  for _spec in mangle:PREROUTING mangle:OUTPUT nat:OUTPUT; do
    _t=${_spec%%:*}
    _c=${_spec##*:}
    if iptables -t "$_t" -L "$_c" -n >/dev/null 2>&1; then
      _r=$(iptables -t "$_t" -L "$_c" -n -v --line-numbers 2>/dev/null | awk '$1 == 1 { print; exit }')
      if echo "${_r}" | grep -q "${tun_iface}"; then
        echo "  OK   ${_t}/${_c} rule 1: ${_r}"
      else
        echo "  BAD  ${_t}/${_c} rule 1: ${_r:-<empty>}   (tunnel traffic is NOT exempt)"
      fi
    else
      echo "  --   ${_t}/${_c}: chain does not exist"
    fi
  done
  if iptables -t mangle -L PREROUTING -n -v --line-numbers 2>/dev/null | grep -q DIVERT; then
    echo "  note: a proxy DIVERT jump exists in mangle PREROUTING; the OK line above"
    echo "        must come first or tailnet TCP (not ICMP) will be hijacked."
  fi
}

show_diag() {
  echo "=== tailscaled diagnostic ==="
  echo "time:          $(date +'%Y-%m-%d %H:%M:%S')"
  echo "binary:        ${tailscaled_bin}"
  echo "  present:     $([ -f "${tailscaled_bin}" ] && echo yes || echo NO)"
  echo "  hash:        $(hash_file "${tailscaled_bin}")"
  echo "  pristine:    $([ -f "${tailscaled_bin_pristine}" ] && echo yes || echo NO)  expected hash: $(cat "${tailscaled_bin_sum}" 2>/dev/null)"
  echo "daemon pid:    $(daemon_pid)"
  echo "socket:        $([ -S "${tailscale_dir}/run/tailscaled.sock" ] && echo present || echo absent)"
  echo "watchdog pid:  $(cat "${tailscaled_run_dir}/watchdog.pid" 2>/dev/null)"
  echo "routes file:   ${tailscale_routes_file} $([ -f "${tailscale_routes_file}" ] && echo '(present)' || echo '(missing - using default 100.64.0.0/10)')"
  echo ""
  show_routes
  echo ""
  echo "tunnel exemptions (rule 1 of each chain must RETURN tunnel traffic):"
  show_exemptions
  echo ""
  echo "daemon log (last 10 lines):"
  tail -n 10 "${tailscaled_log}" 2>/dev/null | sed 's/^/  /'
  echo ""
  echo "--- recent diagnostic log ---"
  tail -n 40 "${tailscaled_diag_log}" 2>/dev/null
}

log_view() {
  case "$1" in
    runs)       tail -n 200 -F "${tailscaled_runs_log}" ;;
    service)    tail -n 200 -F "${tailscaled_service_log}" ;;
    tailscaled) tail -n 200 -F "${tailscaled_log}" ;;
    diag)       tail -n 200 -F "${tailscaled_diag_log}" ;;
    *)
      [ -n "$1" ] && echo "${scripts_name} log $1 not found"
      echo "usage: ${scripts_name} log {runs|service|tailscaled|diag}"
      ;;
  esac
}

# ------------------------------------------------------- subnet discovery ---
# The control plane tells every node which subnet routes it can reach
# (ipnstate.PeerStatus.PrimaryRoutes). Read them from `tailscale status --json`,
# write them to routes.auto and install routing for them. Hand-written entries in
# `routes` are kept and merged, never clobbered.
#
# PrimaryRoutes is only populated for routes we actually accepted, so
# --accept-routes must be on first; otherwise there is nothing to discover.
# Exit code 2 means exactly that, so the WebUI can offer to enable it.
routes_sync() {
  if [ -z "$(daemon_pid)" ] || [ ! -S "${tailscale_dir}/run/tailscaled.sock" ]; then
    diag "routes-sync: daemon/socket not available"
    return 1
  fi

  if ! "${tailscale_bin}" ${tailscale_bin_param} debug prefs 2>/dev/null | grep -q '"RouteAll": *true'; then
    diag "routes-sync: --accept-routes is OFF, so the netmap carries no subnet routes"
    return 2
  fi

  _json=$("${tailscale_bin}" ${tailscale_bin_param} status --json 2>/dev/null)
  _found=$(printf '%s' "${_json}" | tr -d ' \n\t' \
             | grep -o '"PrimaryRoutes":\[[^]]*\]' \
             | grep -o '[0-9a-fA-F:.]\+/[0-9]\+' | sort -u)
  _old=$(grep -E '^[0-9a-fA-F:.]+/[0-9]+$' "${tailscale_routes_auto_file}" 2>/dev/null | sort -u)

  if [ "${_found}" = "${_old}" ]; then
    diag "routes-sync: unchanged ($(printf '%s' "${_found}" | tr '\n' ' '))"
    return 0
  fi

  {
    echo "# Written by 'tailscaled.service routes-sync'. Regenerated automatically,"
    echo "# so local edits here are lost - put your own entries in 'routes' instead."
    echo "# Updated: $(date +'%Y-%m-%d %H:%M:%S')"
    if [ -n "${_found}" ]; then
      printf '%s\n' "${_found}"
    else
      echo "# no subnet routes visible yet - is --accept-routes on and the route"
      echo "# approved in the admin console?"
    fi
  } > "${tailscale_routes_auto_file}" 2>/dev/null

  diag "routes-sync: discovered [$(printf '%s' "${_found}" | tr '\n' ' ')]"
  routes_reload
  return 0
}

# ------------------------------------------------------------ preferences ---
_jbool() {
  _v=$(printf '%s' "$1" | grep -o "\"$2\": *[a-z]*" | head -n1 | sed 's/.*: *//')
  case "${_v}" in true) echo 1 ;; *) echo 0 ;; esac
}

_jstr() {
  printf '%s' "$1" | grep -o "\"$2\": *\"[^\"]*\"" | head -n1 | sed 's/.*"\([^"]*\)"$/\1/'
}

# Machine-readable Tailscale preferences for the WebUI.
show_prefs() {
  _p=$("${tailscale_bin}" ${tailscale_bin_param} debug prefs 2>/dev/null)
  if [ -z "${_p}" ]; then
    echo "prefs_ok=0"
    return 1
  fi
  echo "prefs_ok=1"
  echo "accept_routes=$(_jbool "${_p}" RouteAll)"
  echo "accept_dns=$(_jbool "${_p}" CorpDNS)"
  echo "shields_up=$(_jbool "${_p}" ShieldsUp)"
  echo "want_running=$(_jbool "${_p}" WantRunning)"
  echo "logged_out=$(_jbool "${_p}" LoggedOut)"
  echo "hostname=$(_jstr "${_p}" Hostname)"
  echo "exit_node=$(_jstr "${_p}" ExitNodeID)"
  echo "advertise_routes=$(printf '%s' "${_p}" | tr -d ' \n' \
        | grep -o '"AdvertiseRoutes":\[[^]]*\]' | grep -o '[0-9a-fA-F:.]\+/[0-9]\+' | tr '\n' ',')"
  echo "discovered=$(grep -E '^[0-9a-fA-F:.]+/[0-9]+$' "${tailscale_routes_auto_file}" 2>/dev/null | tr '\n' ',')"
}

# Whitelisted preference changes. The value is always passed as a single
# argument, and only known keys are accepted, so the WebUI cannot inject flags.
set_pref() {
  _k=$1
  _v=$2
  case "$_k" in
    accept-routes)      _flag="--accept-routes=$(_onoff "${_v}")" ;;
    accept-dns)         _flag="--accept-dns=$(_onoff "${_v}")" ;;
    shields-up)         _flag="--shields-up=$(_onoff "${_v}")" ;;
    exit-node-allow-lan) _flag="--exit-node-allow-lan-access=$(_onoff "${_v}")" ;;
    advertise-exit-node) _flag="--advertise-exit-node=$(_onoff "${_v}")" ;;
    auto-update)        _flag="--auto-update=$(_onoff "${_v}")" ;;
    hostname)
      case "${_v}" in
        *[!A-Za-z0-9.-]*|"") diag "set-pref: invalid hostname"; return 1 ;;
      esac
      _flag="--hostname=${_v}" ;;
    advertise-routes)
      case "${_v}" in
        "") _flag="--advertise-routes=" ;;
        *[!0-9a-fA-F:.,/]*) diag "set-pref: invalid route list"; return 1 ;;
        *) _flag="--advertise-routes=${_v}" ;;
      esac ;;
    exit-node)
      # Refused on purpose: see the note in the WebUI. Without SO_MARK the
      # daemon's own packets would be routed back into its own tunnel.
      diag "set-pref: exit-node is not supported by this module"
      return 3 ;;
    *)
      diag "set-pref: unknown key [${_k}]"
      return 1 ;;
  esac
  diag "set-pref: ${_k} -> ${_flag}"
  if "${tailscale_bin}" ${tailscale_bin_param} set "${_flag}" >>"${tailscaled_diag_log}" 2>&1; then
    return 0
  fi
  return 1
}

_onoff() {
  case "$1" in
    on|true|1|yes|enable) echo "true" ;;
    *) echo "false" ;;
  esac
}

logout_now() {
  stop_watchdog
  "${tailscale_bin}" ${tailscale_bin_param} logout >/dev/null 2>&1
  "${tailscale_bin}" ${tailscale_bin_param} down >/dev/null 2>&1
  diag "logout: done"
  return 0
}

# --------------------------------------------------------- WebUI helpers ---
# Verdict for one chain: is rule 1 a RETURN for tunnel traffic?
_exempt_state() {
  _t=$1
  _c=$2
  iptables -t "$_t" -L "$_c" -n >/dev/null 2>&1 || { echo "--"; return; }
  _r=$(iptables -t "$_t" -L "$_c" -n -v --line-numbers 2>/dev/null | awk '$1 == 1 { print; exit }')
  if echo "${_r}" | grep -q "${tun_iface}"; then echo "OK"; else echo "BAD"; fi
}

# Machine-readable status for the WebUI: plain key=value lines.
show_webstatus() {
  _pid=$(daemon_pid)
  if [ -n "${_pid}" ]; then echo "daemon=1"; echo "pid=${_pid}"; else echo "daemon=0"; echo "pid="; fi

  _wp=$(cat "${tailscaled_run_dir}/watchdog.pid" 2>/dev/null)
  if [ -n "${_wp}" ] && kill -0 "${_wp}" 2>/dev/null; then
    echo "watchdog=1"; echo "watchdog_pid=${_wp}"
  else
    echo "watchdog=0"; echo "watchdog_pid="
  fi

  echo "iface=${tun_iface}"
  _ip=$(ip -o -4 addr show "${tun_iface}" 2>/dev/null | awk '{print $4}' | head -n1)
  [ -n "${_ip}" ] || _ip=$("${tailscale_bin}" ${tailscale_bin_param} ip -4 2>/dev/null | head -n1)
  echo "ip4=${_ip}"
  echo "routes=$(route_prefixes | tr '\n' ' ')"
  echo "routes_auto=$(grep -cE '^[0-9a-fA-F:.]+/[0-9]+$' "${tailscale_routes_auto_file}" 2>/dev/null)"
  echo "version=$(awk -F'=' '/^version=/ { print $2 }' "${module_prop}" 2>/dev/null)"

  _want=$(cat "${tailscaled_bin_sum}" 2>/dev/null)
  _have=$(hash_file "${tailscaled_bin}")
  if [ -z "${_want}" ] || [ "${_have}" = "${_want}" ]; then
    echo "binary_ok=1"
  else
    echo "binary_ok=0"
  fi

  echo "exempt_prerouting=$(_exempt_state mangle PREROUTING)"
  echo "exempt_output=$(_exempt_state mangle OUTPUT)"
  echo "exempt_nat=$(_exempt_state nat OUTPUT)"

  _backend=""
  _user=""
  _health=""
  if [ -n "${_pid}" ] && [ -S "${tailscale_dir}/run/tailscaled.sock" ]; then
    _json=$("${tailscale_bin}" ${tailscale_bin_param} status --json 2>/dev/null)
    _backend=$(printf '%s' "${_json}" | grep -o '"BackendState": *"[^"]*"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/')
    _user=$(printf '%s' "${_json}" | grep -o '"LoginName": *"[^"]*"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/')
    _health=$("${tailscale_bin}" ${tailscale_bin_param} status 2>&1 | grep '^#' | sed 's/^#[[:space:]]*//' | head -n 3 | tr '\n' ';')
  fi
  echo "backend=${_backend}"
  echo "user=${_user}"
  echo "health=${_health}"
}

# Re-read the routes file: drop everything we installed, then install it again.
routes_reload() {
  _guard=0
  while [ "${_guard}" -lt 100 ]; do
    _p=$(ip rule show 2>/dev/null | grep "lookup ${tun_table}\$" | head -n1 | awk -F: '{print $1}')
    [ -n "${_p}" ] || break
    ip rule del pref "${_p}" 2>/dev/null || break
    _guard=$((_guard + 1))
  done
  ip route show 2>/dev/null | grep "dev ${tun_iface} metric 1" | while read -r _r; do
    ip route del ${_r} 2>/dev/null
  done
  ip route flush table "${tun_table}" 2>/dev/null
  diag "routes-reload: cleared old rules, re-reading ${tailscale_routes_file}"
  add_routes
}

# ------------------------------------------------------------------ dispatch --
case "$1" in
  start)      start_tailscaled ;;
  stop)       stop_tailscaled ;;
  restart)    stop_tailscaled; sleep 1; start_tailscaled ;;
  status)     show_status ;;
  routes)     show_routes ;;
  diag)       show_diag ;;
  webstatus)  show_webstatus ;;
  routes-reload) routes_reload ;;
  routes-sync)   routes_sync ;;
  prefs)      show_prefs ;;
  set-pref)   set_pref "$2" "$3" ;;
  logout)     logout_now ;;
  log)        log_view "$2" ;;
  __watchdog) route_watchdog ;;
  *)
    echo "usage: ${scripts_name} {start|stop|restart|status|routes|routes-reload|routes-sync|diag|webstatus|prefs|set-pref <key> <value>|logout|log{runs|service|tailscaled|diag}}"
    ;;
esac

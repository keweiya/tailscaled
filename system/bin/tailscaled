#!/system/bin/sh
# `tailscaled` wrapper.
#
# With no arguments it delegates to the service (which applies the binary guard
# and installs the routing). With arguments it runs the binary directly, so
# flags such as --version / --help still work.
. /data/adb/tailscale/settings.ini

if [ $# -eq 0 ]; then
  exec "${tailscaled_service}" start
fi

exec "${tailscaled_bin}" "$@"
